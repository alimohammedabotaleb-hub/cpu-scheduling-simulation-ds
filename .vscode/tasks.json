{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run CPU Scheduling Simulator",
      "type": "shell",
      "command": "bash",
      "args": ["run_github.sh"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run additional comparison sample",
      "type": "shell",
      "command": "bash",
      "args": ["run_github.sh", "--compare"],
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "focus": true, "panel": "dedicated", "clear": true},
      "problemMatcher": ["$gcc"]
    }
  ]
}
